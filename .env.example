# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Neon (Vercel ↔ Neon integration пушит автоматически в Vercel envs;
# локально подтянуть через `vercel env pull .env.local`)
DATABASE_URL=

# --- Email (подтверждение, magic-link, инвайты) ---
# Приоритет транспорта: SMTP → Resend → console-лог (если ничего не задано).

# Вариант A — SMTP (любой провайдер с верификацией одного адреса: Brevo, Gmail,
# Mailjet). Свой домен НЕ нужен — достаточно подтвердить один email у провайдера.
# Пример для Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<логин из Brevo>
# SMTP_PASS=<SMTP-ключ из Brevo>

# Вариант B — Resend (нужен свой верифицированный домен).
# RESEND_API_KEY=re_...

# Отправитель. Для SMTP — верифицированный у провайдера адрес (можно gmail),
# для Resend — адрес на твоём домене. Если не задан — тестовый onboarding@resend.dev.
# EMAIL_FROM=Mesto <noreply@example.com>

# --- Telegram (бесплатное подтверждение аккаунта через бота) ---
# 1. Создай бота через @BotFather → получишь токен и username.
# 2. Зарегистрируй webhook (один раз):
#    https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<APP_URL>/api/telegram/webhook&secret_token=<SECRET>
# Без этих переменных подтверждение через Telegram скрыто, работает только email.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=MestoBot
# TELEGRAM_WEBHOOK_SECRET=<любая_случайная_строка>

# Vercel Cron — секрет для авторизации Cron-вызовов /api/cron/*.
# Локально не нужен, на проде задаётся в Vercel project env.
# CRON_SECRET=
