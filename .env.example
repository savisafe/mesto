# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Backend (текущий внешний NestJS — будет удалён при миграции на Neon)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Neon (Vercel ↔ Neon integration пушит автоматически в Vercel envs;
# локально подтянуть через `vercel env pull .env.local`)
DATABASE_URL=

# Resend — отправка email (подтверждение, magic-link, инвайты).
# Без RESEND_API_KEY письма не отправляются (уходят в console-лог сервера).
# RESEND_API_KEY=re_...
# Отправитель: адрес на верифицированном в Resend домене.
# Если не задан — используется тестовый onboarding@resend.dev
# (доставляет только на email владельца Resend-аккаунта).
# EMAIL_FROM=Mesto <noreply@example.com>

# Vercel Cron — секрет для авторизации Cron-вызовов /api/cron/*.
# Локально не нужен, на проде задаётся в Vercel project env.
# CRON_SECRET=
